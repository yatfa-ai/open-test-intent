__pycache__/
*.py[cod]

# Go build artifacts. The parity harness builds the port into bin/ because both
# implementations resolve the schema relative to their own location, so the
# binary has to sit beside bin/validate-intent for their schema paths to agree.
/bin/validate-intent-go
/bin/validate-intent-go.exe
# A single-package build from the repo root drops the binary here under its
# package name, e.g. `go build ./cmd/validate-intent`. (`go build ./...` no
# longer does: since tests/cross/inspect-artifact added a second main package,
# Go discards the results of a multi-package build rather than writing them.)
/validate-intent
/inspect-artifact
*.test

# Cross-compiled artifacts for the four roadmap targets. Two producers write
# under here, into separate subtrees because they build the same filenames from
# different flags: tests/cross/run_cross_build.sh puts UNSTAMPED builds in
# dist/ and verifies them in place, and scripts/build-release.sh puts
# version-stamped ones in dist/release/. Both are on-demand; this repo
# publishes neither, so nothing under here is committed.
/dist/
